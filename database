datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TicketStatus {
  ACTIVE
  PENDING_CANCEL
  CANCELLED
  TRANSFERRED
  EXPIRED
}

enum QueueStatus {
  WAITING        // User is currently queued
  OFFERED        // A ticket became available; user has a timed window to claim
  CLAIMED        // User accepted and claimed the offered ticket
  EXPIRED        // User missed the claim window; offer moved to next person
  LEFT_QUEUE     // User voluntarily left the waitlist
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  REFUNDED
  FAILED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  fullName            String
  phoneNumber         String               @unique
  stripeCustomerId    String?
  fcmPushToken        String?
  createdAt           DateTime             @default(now())

  ticketsOwned        Ticket[]             @relation("TicketOwner")
  queueEntries        QueueEntry[]
  transactions        Transaction[]
}

model Venue {
  id                  String               @id @default(uuid())
  name                String
  address             String
  city                String
  totalCapacity       Int
  events              Event[]
}

model Event {
  id                  String               @id @default(uuid())
  venueId             String
  title               String
  description         String?
  coverImageUrl       String?
  eventDate           DateTime
  isSoldOut           Boolean              @default(true)
  claimWindowMinutes  Int                  @default(15) // Dynamic ticket acceptance window
  createdAt           DateTime             @default(now())

  venue               Venue                @relation(fields: [venueId], references: [id])
  tickets             Ticket[]
  waitlist            QueueEntry[]
}

model Ticket {
  id                  String               @id @default(uuid())
  eventId             String
  ownerId             String
  tierName            String               @default("General Admission") // e.g., GA, VIP, Floor
  seatIdentifier      String?              // e.g., "Section 102, Row B, Seat 14"
  originalPrice       Decimal              @db.Decimal(10, 2)
  qrCodeHash          String               @unique
  status              TicketStatus         @default(ACTIVE)
  purchasedAt         DateTime             @default(now())

  event               Event                @relation(fields: [eventId], references: [id])
  owner               User                 @relation("TicketOwner", fields: [ownerId], references: [id])
  transactions        Transaction[]
}

model QueueEntry {
  id                  String               @id @default(uuid())
  eventId             String
  userId              String
  queuePosition       Int                  // Strictly sequential order
  requestedQuantity   Int                  @default(1)
  status              QueueStatus          @default(WAITING)
  offeredTicketId     String?
  offerExpiresAt      DateTime?            // Hard deadline to accept an offered ticket
  joinedAt            DateTime             @default(now())

  event               Event                @relation(fields: [eventId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model Transaction {
  id                  String               @id @default(uuid())
  ticketId            String
  userId              String
  amount              Decimal              @db.Decimal(10, 2)
  stripePaymentIntent String               @unique
  status              PaymentStatus        @default(SUCCESSFUL)
  processedAt         DateTime             @default(now())

  ticket              Ticket               @relation(fields: [ticketId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
}
