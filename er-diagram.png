
<style>
#erd { padding: 1rem 0; }
#erd svg { max-width: 100%; }
</style>
<div id="erd"></div>
<script type="module">
import mermaid from 'https://esm.sh/mermaid@11/dist/mermaid.esm.min.mjs';
const dark = document.documentElement.dataset.mode === 'dark' || matchMedia('(prefers-color-scheme: dark)').matches;
await document.fonts.ready;
mermaid.initialize({
  startOnLoad: false,
  theme: 'base',
  fontFamily: '"anthropic-sans", sans-serif',
  themeVariables: {
    darkMode: dark,
    fontSize: '13px',
    fontFamily: '"anthropic-sans", sans-serif',
    lineColor: dark ? '#9c9a92' : '#73726c',
    textColor: dark ? '#c2c0b6' : '#3d3d3a',
    primaryColor: dark ? '#2a2a2a' : '#f0f4ff',
    primaryBorderColor: dark ? '#534AB7' : '#534AB7',
    primaryTextColor: dark ? '#c2c0b6' : '#26215C',
  },
});
const diagram = `erDiagram
  SEATS {
    text id PK
    text row_label
    int seat_number
    text status
    text locked_by
    timestamp locked_at
    timestamp expires_at
    text confirmed_by
  }
  WAITLIST {
    uuid id PK
    text seat_id FK
    text phone
    int position
    timestamp joined_at
    boolean notified
  }
  USERS {
    uuid id PK
    text phone UK
    text name
    text email
    text city
    timestamp created_at
    timestamp last_active
  }
  SHOWS {
    text id PK
    text movie_title
    text theatre_name
    text city
    text show_time
    date show_date
    text format
    int total_seats
    int price_classic
    int price_prime
    int price_recliner
  }
  BOOKINGS {
    uuid id PK
    text user_phone FK
    text seat_id FK
    text show_id FK
    text status
    timestamp booked_at
    int amount_paid
    text payment_method
  }
  NOTIFICATIONS {
    uuid id PK
    text user_phone
    text seat_id FK
    text show_id FK
    text message
    text type
    text status
    timestamp sent_at
    text twilio_sid
  }
  ADMIN_LOGS {
    uuid id PK
    text action
    text seat_id
    text show_id
    text phone
    text details
    text performed_by
    timestamp created_at
  }

  SEATS ||--o{ WAITLIST : "has queue"
  SEATS ||--o{ BOOKINGS : "booked as"
  SEATS ||--o{ NOTIFICATIONS : "triggers"
  USERS ||--o{ BOOKINGS : "makes"
  SHOWS ||--o{ BOOKINGS : "contains"
  SHOWS ||--o{ NOTIFICATIONS : "related to"
`;
const { svg } = await mermaid.render('erd-svg', diagram);
document.getElementById('erd').innerHTML = svg;

document.querySelectorAll('#erd svg .node').forEach(node => {
  const firstPath = node.querySelector('path[d]');
  if (!firstPath) return;
  const d = firstPath.getAttribute('d');
  const nums = d.match(/-?[\d.]+/g)?.map(Number);
  if (!nums || nums.length < 8) return;
  const xs = [nums[0], nums[2], nums[4], nums[6]];
  const ys = [nums[1], nums[3], nums[5], nums[7]];
  const x = Math.min(...xs), y = Math.min(...ys);
  const w = Math.max(...xs) - x, h = Math.max(...ys) - y;
  const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
  rect.setAttribute('x', x); rect.setAttribute('y', y);
  rect.setAttribute('width', w); rect.setAttribute('height', h);
  rect.setAttribute('rx', '8');
  for (const a of ['fill', 'stroke', 'stroke-width', 'class', 'style']) {
    if (firstPath.hasAttribute(a)) rect.setAttribute(a, firstPath.getAttribute(a));
  }
  firstPath.replaceWith(rect);
});

document.querySelectorAll('#erd svg .row-rect-odd path, #erd svg .row-rect-even path').forEach(p => {
  p.setAttribute('stroke', 'none');
});
</script>
